# =============================================================================
# deploy/.env.prod.example — Modèle du fichier .env du SERVEUR (M8)
#
# Sur le serveur : copier ce fichier en ~/talentgraph/.env, puis remplacer
# CHANGE_ME par un mot de passe FORT, généré sur le serveur avec :
#     openssl rand -hex 32
# (64 caractères 0-9 a-f : long, aléatoire, sans caractère spécial gênant).
#
# Le vrai .env NE DOIT JAMAIS être commité ni partagé : il reste sur le serveur.
# =============================================================================
POSTGRES_USER=talentgraph
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=talentgraph
